{
  "name": "itinerary-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=app-web",
    "lint:shared": "turbo run lint --filter=shared",
    "format": "prettier --write .",
    "prepare": "husky",
    "type-gen": "npx supabase gen types typescript --project-id \"ziruybkjpdnluxjmgopl\" --schema public > packages/app-web/src/database.types.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "husky": "^9.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.8.3",
    "turbo": "^2.2.2"
  }
}
