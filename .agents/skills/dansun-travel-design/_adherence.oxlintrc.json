{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/calendar/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/overlays/**",
              "components/surfaces/**",
              "ui_kits/dansun-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard Variable|JejuStoneWall|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Pretendard Variable, JejuStoneWall, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|confirmLabel|cancelLabel|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<AlertModal> doesn't accept that prop. Declared props: open, title, description, confirmLabel, cancelLabel, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlldayEventBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|offsetDays|spanDays|onClick|key|ref|className|style|children)$/]",
        "message": "<AlldayEventBar> doesn't accept that prop. Declared props: title, offsetDays, spanDays, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|avatarSrc|theme|onBack|onThemeChange|onProfile|onSignOut|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: variant, title, avatarSrc, theme, onBack, onThemeChange, onProfile, onSignOut."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:global|project)$/]",
        "message": "<AppHeader> variant must be one of 'global' | 'project'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:system|light|dark)$/]",
        "message": "<AppHeader> theme must be one of 'system' | 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|success|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'success' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|project|todo|calendar)$/]",
        "message": "<BottomNav> active must be one of 'home' | 'project' | 'todo' | 'calendar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|iconOnly|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, iconOnly, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|brand|destructive|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'brand' | 'destructive' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarEventItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|startHour|startMinute|endHour|endMinute|columnIndex|onClick|key|ref|className|style|children)$/]",
        "message": "<CalendarEventItem> doesn't accept that prop. Declared props: title, startHour, startMinute, endHour, endMinute, columnIndex, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:accentColor|muted|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: accentColor, muted, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|id|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, label, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreateTodoPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|key|ref|className|style|children)$/]",
        "message": "<CreateTodoPrompt> doesn't accept that prop. Declared props: label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, onClose, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Empty'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|illustration|key|ref|className|style|children)$/]",
        "message": "<Empty> doesn't accept that prop. Declared props: title, description, action, illustration."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|type|invalid|disabled|leadingIcon|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: placeholder, value, type, invalid, disabled, leadingIcon, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<InputGroup> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:htmlFor|muted|children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: htmlFor, muted, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|key|ref|className|style|children)$/]",
        "message": "<Loader> doesn't accept that prop. Declared props: label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute > JSXIdentifier[name!=/^(?:trigger|items|align|width|key|ref|className|style|children)$/]",
        "message": "<Popover> doesn't accept that prop. Declared props: trigger, items, align, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Popover'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Popover> align must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:avatarSrc|nickname|bio|editable|onEdit|key|ref|className|style|children)$/]",
        "message": "<ProfileSummary> doesn't accept that prop. Declared props: avatarSrc, nickname, bio, editable, onEdit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|owner|joined|onJoin|onDelete|onClick|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: name, description, owner, joined, onJoin, onDelete, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|placeholder|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, placeholder, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|id|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|rows|invalid|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: placeholder, value, rows, invalid, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|message|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|error|warning|info)$/]",
        "message": "<Toast> tone must be one of 'success' | 'error' | 'warning' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TodoItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|confirmed|onToggle|onEdit|onDelete|key|ref|className|style|children)$/]",
        "message": "<TodoItem> doesn't accept that prop. Declared props: title, confirmed, onToggle, onEdit, onDelete."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeeklyCalendar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|height|startHour|key|ref|className|style|children)$/]",
        "message": "<WeeklyCalendar> doesn't accept that prop. Declared props: children, height, startHour."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:monthLabel|dates|selectedIndex|onSelect|onPrev|onNext|key|ref|className|style|children)$/]",
        "message": "<WeekStrip> doesn't accept that prop. Declared props: monthLabel, dates, selectedIndex, onSelect, onPrev, onNext."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
